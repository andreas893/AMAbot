<!DOCTYPE html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AMAbot</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chivo+Mono:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/styles/style.css" />
  </head>
  
  <body>
     <!-- <canvas id="ascii-background" aria-hidden="true"></canvas> -->
    <main class="chat-app">
        
     
        <header class="chat-header">
        <div class="avatar" aria-hidden="true">
           <video
                class="ascii-animation"
                autoplay
                loop
                muted
                playsinline
                aria-label="ASCII-animation af Killua"
                >
                <source
                    src="/assets/images/dot-loop.mp4"
                    type="video/mp4"
                >
            </video>
        </div>
        <div>
          <h1>Andreas' AMAbot</h1>
          <p><span class="status-dot"></span> Spørg mig om alt</p>
        </div>

        <div>
          <form method="POST" action="/clear">
            <button type="submit" class="clear-button">Ryd beskeder</button>
          </form>
        </div>

        <div>
          <h3>Spørgsmål fordelt på emner</h3>
          <ul>
            <li>Navn: <%= topicStats.name %></li>
            <li>Bosted: <%= topicStats.city %></li>
            <li>Fritid: <%= topicStats.hobby %></li>
          </ul>
        </div>
      </header>

      <section id="chatMessages" class="chat-messages" aria-live="polite">
          <article class="message answer">
          <p>
            Hej! Jeg er Andreas' AMAbot 👋 Spørg mig fx om
            uddannelse, interesser eller erfaring.
          </p>

          <time>Nu</time>
        </article>
        
        <!-- Chat svar -->
        <% for (const message of messages) { %>
        <article class="message <%= message.type %>">
          <p><%= message.text %></p>
          <time><%= message.createdAt.toLocaleTimeString("da-DK") %></time>
        </article>  
        <% } %>

        <% if (error) { %>
          <article class="error message">
            <p role="alert"><%= error %></p>
          </article>
        <% } %>
      </section>

      <form id="chatForm" class="chat-form" method="POST" action="/ask">
        <label class="sr-only" for="question">Skriv et spørgsmål</label>
        <input
          id="question"
          name="question"
          type="question"
          text=question
          placeholder="Stil mig et spørgsmål..."
          autocomplete="off"
        />
        <button type="submit">Send</button>
      </form>
    </main>

    <script src="/assets/ascii.js"></script>
  </body>
</html>